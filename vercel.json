{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/pivot",
      "destination": "/hillsidedance",
      "permanent": true
    },
    {
      "source": "/pivot.html",
      "destination": "/hillsidedance",
      "permanent": true
    },
    {
      "source": "/portal",
      "destination": "/portal-limited",
      "permanent": false
    },
    {
      "source": "/portal.html",
      "destination": "/portal-limited",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_s/(.*)\\.woff2\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/woff2"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_s/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}